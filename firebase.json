{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "predeploy": [],
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "headers": [
      {
        "source": "/",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/index.html",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/admin",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/log",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/build-info.json",
        "headers": [{"key": "Cache-Control", "value": "no-store"}]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/admin",
        "function": "adminApi"
      },
      {
        "source": "/api/history",
        "function": "history"
      },
      {
        "source": "/api",
        "function": "status"
      },
      {
        "source": "/**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
